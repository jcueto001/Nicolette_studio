# Configuración de Flow.cl (Abonos de $5.000)
# Obten tus llaves en:
# - Sandbox (Pruebas): https://sandbox.flow.cl (Menú Mis Datos -> Seguridad)
# - Producción: https://www.flow.cl (Menú Mis Datos -> Seguridad)

PORT=3000
FLOW_API_KEY=tu_api_key_aqui
FLOW_SECRET_KEY=tu_secret_key_aqui
FLOW_SANDBOX=true

# URLs de entorno (opcionales para desarrollo local)
FRONTEND_URL=http://127.0.0.1:5500/index.html
BACKEND_URL=http://localhost:3000
